# Clé API Gemini gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modèle : gemini-3.5-flash-lite (rapide). gemini-3.8-flash est plus fin mais très lent en offre gratuite.
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=8787
FREE_ANALYSES=3

# WhatsApp (API Cloud de Meta) — laisser vide pour désactiver
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Mot de passe que tu inventes, à recopier dans Meta lors de la configuration du webhook
WHATSAPP_VERIFY_TOKEN=

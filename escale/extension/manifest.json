{
  "manifest_version": 3,
  "name": "Escale – ton agent vacances",
  "version": "0.2.0",
  "description": "Un agent IA qui analyse la page de voyage que tu regardes et t'aide à choisir ta destination.",
  "action": {
    "default_title": "Ouvrir Escale",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "activeTab"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}